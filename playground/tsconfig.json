{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": false,
    "types": ["vite/client"]
  },
  "vueCompilerOptions": { "strictTemplates": true },
  "include": ["src/**/*", "vite.config.ts"]
}
