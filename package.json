{
  "name": "@wssto2/vue-core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Vue 3 library for go-core applications: app shell, list / record / form pages and their controls.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js"
    },
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "import": "./dist/overlay/index.js"
    },
    "./modal": {
      "types": "./dist/modal/index.d.ts",
      "import": "./dist/modal/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./src/styles/tailwind.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint . && node scripts/check-src-imports.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && vite build -c vite.styles.config.ts && vue-tsc -p tsconfig.build.json",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:consumer"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-i18n": "^10.0.0-beta.5",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.8",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.4.0",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.8"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "vue-sonner": "^1.3.2"
  }
}
