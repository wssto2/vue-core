{
 "description": "Cases of visible_when (content-spec 4.4). evaluateVisibility(rule, values) must return `visible` for each case. Shared by vue-core's tests and the Go tests of site-builder: copy this file, do not edit the copy. Rules: no rule or no conditions = visible; all = every condition, any = at least one; eq/ne/in compare JSON values strictly (1 is not true) and lists/objects by content; empty = null, missing, blank string, empty list, or an object whose entries are all empty (false and 0 are values); a condition with an unknown operator, or `in` without a list, is skipped and a rule with no valid condition is visible.",
 "cases": [
  {
   "name": "no rule is visible",
   "rule": null,
   "values": {},
   "visible": true
  },
  {
   "name": "empty all is visible",
   "rule": {
    "all": []
   },
   "values": {},
   "visible": true
  },
  {
   "name": "empty any is visible",
   "rule": {
    "any": []
   },
   "values": {},
   "visible": true
  },
  {
   "name": "eq true holds",
   "rule": {
    "all": [
     {
      "field": "replied",
      "eq": true
     }
    ]
   },
   "values": {
    "replied": true
   },
   "visible": true
  },
  {
   "name": "eq true fails on false",
   "rule": {
    "all": [
     {
      "field": "replied",
      "eq": true
     }
    ]
   },
   "values": {
    "replied": false
   },
   "visible": false
  },
  {
   "name": "eq true fails when the field is missing",
   "rule": {
    "all": [
     {
      "field": "replied",
      "eq": true
     }
    ]
   },
   "values": {},
   "visible": false
  },
  {
   "name": "eq is strict: 1 is not true",
   "rule": {
    "all": [
     {
      "field": "replied",
      "eq": true
     }
    ]
   },
   "values": {
    "replied": 1
   },
   "visible": false
  },
  {
   "name": "eq is strict: '1' is not 1",
   "rule": {
    "all": [
     {
      "field": "n",
      "eq": 1
     }
    ]
   },
   "values": {
    "n": "1"
   },
   "visible": false
  },
  {
   "name": "eq on a string",
   "rule": {
    "all": [
     {
      "field": "type",
      "eq": "video"
     }
    ]
   },
   "values": {
    "type": "video"
   },
   "visible": true
  },
  {
   "name": "eq compares lists by content",
   "rule": {
    "all": [
     {
      "field": "tags",
      "eq": [
       "a",
       "b"
      ]
     }
    ]
   },
   "values": {
    "tags": [
     "a",
     "b"
    ]
   },
   "visible": true
  },
  {
   "name": "eq compares lists in order",
   "rule": {
    "all": [
     {
      "field": "tags",
      "eq": [
       "a",
       "b"
      ]
     }
    ]
   },
   "values": {
    "tags": [
     "b",
     "a"
    ]
   },
   "visible": false
  },
  {
   "name": "eq null holds for null",
   "rule": {
    "all": [
     {
      "field": "x",
      "eq": null
     }
    ]
   },
   "values": {
    "x": null
   },
   "visible": true
  },
  {
   "name": "eq null fails for a missing field",
   "rule": {
