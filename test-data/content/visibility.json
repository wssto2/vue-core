  {
   "name": "Lavcevic leads: replied_at shows once replied",
   "rule": {
    "all": [
     {
      "field": "replied",
      "eq": true
     }
    ]
   },
   "values": {
    "replied": true,
    "replied_at": null
   },
   "visible": true
  },
  {
   "name": "Lavcevic leads: replied_at hidden while not replied",
   "rule": {
    "all": [
     {
      "field": "replied",
      "eq": true
