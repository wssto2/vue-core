    ]
   },
   "values": {
    "kind": "b"
   },
   "visible": true
  },
  {
   "name": "ne fails",
   "rule": {
    "all": [
     {
      "field": "kind",
      "ne": "a"
     }
    ]
   },
   "values": {
    "kind": "a"
   },
   "visible": false
  },
  {
   "name": "ne holds for a missing field",
   "rule": {
    "all": [
     {
      "field": "kind",
      "ne": "a"
     }
    ]
   },
   "values": {},
   "visible": true
  },
  {
   "name": "in holds",
   "rule": {
    "all": [
     {
      "field": "kind",
      "in": [
       "a",
       "b"
      ]
     }
    ]
   },
   "values": {
    "kind": "b"
